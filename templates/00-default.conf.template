# 默认兜底：所有未匹配到具体 server_name 的请求，返回自定义 404 页面。
# 文件名以 "00-" 开头，确保它是加载时的第一个 server 块，
# 从而承担 default_server 角色，避免请求被误路由到其它站点。

server {
    listen 80 default_server;
    server_name _;

    include /etc/nginx/snippets/error-pages.conf;

    location / {
        return 404;
    }
}

server {
    listen 443 ssl default_server;
    server_name _;

    include /etc/nginx/snippets/ssl.conf;

    include /etc/nginx/snippets/error-pages.conf;

    location / {
        return 404;
    }
}
